# PostgreSQL connection string. Keep real credentials in .env, never commit them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hampajuh

# Generate a unique 32+ character secret for each environment.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
